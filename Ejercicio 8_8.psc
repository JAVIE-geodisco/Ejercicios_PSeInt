Algoritmo TrianguloCreciente
    Definir tamano, i, j Como Entero
    
    Escribir "Introduce el tamaño del triángulo:"
    Leer tamano
    
    Para i <- 1 Hasta tamano Hacer
        Para j <- 1 Hasta i Hacer
            Escribir Sin Saltar "*"
        FinPara
        Escribir ""
    FinPara
FinAlgoritmo

