Algoritmo SumaParesMientras
    Definir num1, num2 Como Real
    
    Escribir "Introduce el primer número:"
    Leer num1
    Escribir "Introduce el segundo número:"
    Leer num2
    
    Mientras num1 <> 0 O num2 <> 0 Hacer
        Escribir "La suma es: ", num1 + num2
        Escribir "Introduce el primer número (0 para salir):"
        Leer num1
        Escribir "Introduce el segundo número (0 para salir):"
        Leer num2
    FinMientras
FinAlgoritmo

